<?xml version="1.0"?>

<robot name="simple_robot">

  <!-- Base Link -->
  <link name="base_link">

    <!-- Visual -->
    <visual>
      <geometry>
        <box size="0.5 0.3 0.1"/>
      </geometry>

      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>

      <origin xyz="0 0 0"/>
    </visual>

    <!-- Collision -->
    <collision>
      <geometry>
        <box size="0.5 0.3 0.1"/>
      </geometry>

      <origin xyz="0 0 0"/>
    </collision>

    <!-- Inertia -->
    <inertial>
      <mass value="1.0"/>

      <origin xyz="0 0 0"/>

      <inertia
        ixx="0.1"
        ixy="0.0"
        ixz="0.0"
        iyy="0.1"
        iyz="0.0"
        izz="0.1"/>
    </inertial>

  </link>

    <!-- Left Wheel -->
  <link name="left_wheel">

    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>

      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>

      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
    </visual>

  </link>

  <!-- Right Wheel -->
  <link name="right_wheel">

    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>

      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>

      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
    </visual>

  </link>

  <!-- Left Wheel Joint -->
  <joint name="left_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="left_wheel"/>

    <origin xyz="0 0.15 -0.05"/>

    <axis xyz="0 1 0"/>

  </joint>

  <!-- Right Wheel Joint -->
  <joint name="right_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="right_wheel"/>

    <origin xyz="0 -0.15 -0.05"/>

    <axis xyz="0 1 0"/>

  </joint>


    <!-- Caster Wheel -->
  <link name="caster_wheel">

    <visual>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>

      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>

      <origin xyz="0 0 0"/>
    </visual>

  </link>

  <!-- Caster Joint -->
  <joint name="caster_joint" type="fixed">

    <parent link="base_link"/>
    <child link="caster_wheel"/>

    <origin xyz="-0.18 0 -0.06"/>

  </joint>


    <!-- Camera Link -->
  <link name="camera_link">

    <visual>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>

      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>

      <origin xyz="0 0 0"/>
    </visual>

  </link>

  <!-- Camera Joint -->
  <joint name="camera_joint" type="fixed">

    <parent link="base_link"/>
    <child link="camera_link"/>

    <origin xyz="0.25 0 0.08"/>

  </joint>


    <!-- LiDAR Link -->
  <link name="lidar_link">

    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.03"/>
      </geometry>

      <material name="green">
        <color rgba="0 1 0 1"/>
      </material>

      <origin xyz="0 0 0"/>
    </visual>

  </link>

  <!-- LiDAR Joint -->
  <joint name="lidar_joint" type="fixed">

    <parent link="base_link"/>
    <child link="lidar_link"/>

    <origin xyz="0.1 0 0.1"/>

  </joint>

</robot>