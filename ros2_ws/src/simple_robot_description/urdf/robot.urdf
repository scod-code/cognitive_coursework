<?xml version="1.0"?>

<robot name="simple_robot">

  <!-- Base Link -->
  <link name="base_link">

    <!-- Visual -->
    <visual>
      <geometry>
        <box size="0.5 0.3 0.1"/>
      </geometry>

      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>

      <origin xyz="0 0 0"/>
    </visual>

    <!-- Collision -->
    <collision>
      <geometry>
        <box size="0.5 0.3 0.1"/>
      </geometry>

      <origin xyz="0 0 0"/>
    </collision>

    <!-- Inertia -->
    <inertial>
      <mass value="1.0"/>

      <origin xyz="0 0 0"/>

      <inertia
        ixx="0.1"
        ixy="0.0"
        ixz="0.0"
        iyy="0.1"
        iyz="0.0"
        izz="0.1"/>
    </inertial>

  </link>

</robot>