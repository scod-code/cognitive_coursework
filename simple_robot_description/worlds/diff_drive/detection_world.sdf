<sdf version="1.6">
  <world name="default">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Add a gray ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Add boundary walls -->
    <!-- North wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 15 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>30 1.0 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>30 1.0 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- South wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -15 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>30 1.0 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>30 1.0 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- East wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>15 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.0 30 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.0 30 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.8 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- West wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-15 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.0 30 3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.0 30 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.2 1</ambient>
            <diffuse>0.8 0.8 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
    
    

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    
    <!-- Traffic Sign Posters -->

    <!-- Stop sign on north wall (facing south, towards arena centre) -->
     <!-- Stop sign on north wall -->
	<include>
	  <uri>model://stop_sign_poster</uri>
	  <name>stop_sign_1</name>
	  <pose>-5 14.4 1.5 0 0 -1.5708</pose>
	</include>

	<!-- Fast sign on east wall -->
	<include>
	  <uri>model://fast_sign_poster</uri>
	  <name>fast_sign_1</name>
	  <pose>14.4 5 1.5 0 0 3.14159</pose>
	</include>

	<!-- Slow sign on south wall -->
	<include>
	  <uri>model://slow_sign_poster</uri>
	  <name>slow_sign_1</name>
	  <pose>5 -14.4 1.5 0 0 1.5708</pose>
	</include>

	<!-- Orange poster on west wall (yaw=0 so box X-axis points east into arena) -->
	<include>
	  <uri>model://orange_poster</uri>
	  <name>orange_poster_1</name>
	  <pose>-14.4 -5 1.5 0 0 0.0</pose>
	</include>

	<!-- Vehicle poster on north wall (yaw=-1.5708 so box X-axis points south into arena) -->
	<include>
	  <uri>model://vehicle_poster</uri>
	  <name>vehicle_poster_1</name>
	  <pose>5 14.4 1.5 0 0 -1.5708</pose>
	</include>

	<!-- Tree poster on east wall (yaw=3.14159 so box X-axis points west into arena) -->
	<include>
	  <uri>model://tree_poster</uri>
	  <name>tree_poster_1</name>
	  <pose>14.4 -5 1.5 0 0 3.14159</pose>
	</include>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic">
      <pressure>101325</pressure>
      <temperature>288.15</temperature>
    </atmosphere>
  </world>
</sdf>
